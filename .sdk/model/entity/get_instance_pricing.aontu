# Entity: get_instance_pricing

main: kit: entity: get_instance_pricing: {

  alias: field: {}

  fields: {
    Cost: {
      fo: "float"
      h: "Cost"
      n: "Cost"
      r: true
      sh: "Hourly cost for on-demand Linux instance in USD"
      t: "`$NUMBER`"
    }
    InstanceType: {
      h: "Instance Type"
      n: "InstanceType"
      r: true
      sh: "The EC2 instance type (e.g., 't2.micro', 'm5.large')"
      t: "`$STRING`"
    }
    Memory: {
      h: "Memory"
      n: "Memory"
      r: true
