    }
    VCPUS: {
      h: "Vcpus"
      n: "VCPUS"
      r: true
      sh: "Number of virtual CPUs"
      t: "`$INTEGER`"
    }
  }

  name: "get_instance_pricing"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "i3"
                k: "query"
                n: "filter"
                or: "filter"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "json"
                or: "json"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "price"
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
