    }
    MonthlyPrice: {
      fo: "float"
      h: "Monthly Price"
      n: "MonthlyPrice"
      r: true
      sh: "Estimated monthly cost in USD (Cost * 730 hours)"
      t: "`$NUMBER`"
    }
    Network: {
      h: "Network"
      n: "Network"
      r: true
      sh: "Network performance capability"
      t: "`$STRING`"
    }
    SpotPrice: {
      h: "Spot Price"
      n: "SpotPrice"
      r: true
      sh: "Current spot instance hourly price in USD, or 'NA' if not available for spot pricing"
      t: "`$STRING`"
    }
    Storage: {
      h: "Storage"
      n: "Storage"
      r: true
      sh: "Storage type and capacity (e.g., 'EBS only', '1 x 80 SSD')"
