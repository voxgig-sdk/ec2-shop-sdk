          "name": "get_instance_pricing",
          "op": {
            "list": {
              "input": "data",
              "name": "list",
              "points": [
                {
                  "active": true,
                  "args": {
                    "query": [
                      {
                        "active": true,
                        "example": "i3",
                        "kind": "query",
                        "name": "filter",
                        "orig": "filter",
                        "reqd": false,
                        "type": "`$STRING`"
                      },
                      {
                        "active": true,
                        "kind": "query",
